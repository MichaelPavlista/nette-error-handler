# Zákaz ladicího a nebezpečného kódu (ekino/phpstan-banned-code).
parametersSchema:
	banned_code: structure([
		nodes: listOf(structure([
			type: string()
			functions: schema(listOf(string()), nullable())
		]))
		use_from_tests: bool()
		non_ignorable: bool()
	])

parameters:
	banned_code:
		nodes:
			# enable detection of eval
			-
				type: Expr_Eval
				functions: null

			# enable detection of a set of functions
			-
				type: Expr_FuncCall
				functions:
					- dd
					- dump
					- passthru
					- phpinfo
					- proc_open
					- shell_exec
					- system
					- var_dump
					- bdump
					- dumpe

		# enable detection of `use Tests\Foo\Bar` in a non-test file
		use_from_tests: true

		# when true, errors cannot be excluded
		non_ignorable: true

services:
	-
		class: Ekino\PHPStanBannedCode\Rules\BannedNodesRule
		tags:
			- phpstan.rules.rule
		arguments:
			- '%banned_code.nodes%'

	-
		class: Ekino\PHPStanBannedCode\Rules\BannedUseTestRule
		tags:
			- phpstan.rules.rule
		arguments:
			- '%banned_code.use_from_tests%'

	-
		class: Ekino\PHPStanBannedCode\Rules\BannedNodesErrorBuilder
		arguments:
			- '%banned_code.non_ignorable%'
